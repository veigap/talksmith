{% import "_macros.j2" as m %}
{% call m.stage(s) %}
{{ m.lead(s) -}}
<div class="cci{{ m.imgpos(s) }}">{% if s.cards %}<div class="ccicards">
{% for c in s.cards %}<div class="ccard sm{{ m.frag(s) }}">{{ icon(c.icon) }}<h3>{{ c.label | nocolon }}</h3><p>{{ c.body }}</p></div>{% endfor %}
</div>{% endif %}{{ embed_img(s.image) }}</div>
{% endcall %}
