{# Working-directory landing page body — one card per rendered deck, in delivery order
   (build_index.py `collect`). The talk's own date heads the card; the render date is secondary. #}
<div class="wrap">
  <header class="mast">
    <h1>{{ L.heading }}</h1>
    <p class="lede">{{ L.lede }}</p>
  </header>
  <ul class="decks">
    {% for e in entries %}
    <li>
      <a class="deck{% if e.draft %} draft{% endif %}" href="{{ e.href }}">
        {% if e.date %}<p class="ddate">{{ e.date }}</p>{% endif %}
        <p class="dt">{{ e.title }}</p>
        {% if e.institution %}<p class="dsub">{{ e.institution }}</p>{% endif %}
        {% if e.cls %}<p class="dsub">{{ e.cls }}</p>{% endif %}
        <p class="dmeta">
          {% if e.draft %}<span class="badge">{{ L.draft }}</span>{% endif %}
          {% if e.stale %}<span class="badge stale" title="{{ L.stale_hint }}">{{ L.stale }}</span>{% endif %}
          {% if e.slides %}<span>{{ e.slides }} {{ L.slides }}</span><span class="sep">·</span>{% endif %}
          {% if e.presenter %}<span>{{ e.presenter }}</span><span class="sep">·</span>{% endif %}
          <span class="drender">{{ L.rendered }} {{ e.rendered }}</span>
        </p>
      </a>
    </li>
    {% endfor %}
  </ul>
  <p class="foot">{{ L.foot }}</p>
</div>
